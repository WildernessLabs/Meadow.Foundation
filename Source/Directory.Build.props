<Project>
  <PropertyGroup>
    <!-- net10.0 surfaced nullability mismatches against framework interfaces/delegates
         in netstandard2.1-era code. Suppress as warnings-not-errors during the .NET 10
         migration; revisit per-driver in a follow-up cleanup pass. -->
    <NoWarn>$(NoWarn);CS8073;CS8597;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8612;CS8618;CS8619;CS8622;CS8714;CS8765;CS8766;CS8767;CA2022</NoWarn>
  </PropertyGroup>
</Project>
